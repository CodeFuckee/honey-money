# 复制为 .env 后按需修改（.env 已被 gitignore，不入库）

# 前端对外端口（DSM 自用 5000/5001，8080 常被占用，默认用 28080）
FRONTEND_PORT=28080

# PostgreSQL 连接串——使用 NAS 上既有的 PG 容器（宿主 5433 端口）。
# 默认值已指向 honey_money 库；如改密码/端口在此覆盖。
DATABASE_URL=postgresql://honey_money:honey_money@host.docker.internal:5433/honey_money

# 公共代理池地址（NAS 上独立部署的 proxy-pool，宿主 5010；backend 取代理与探活用）
PROXY_POOL_URL=http://host.docker.internal:5010
